# Server Configuration
PORT=8080
NODE_ENV=development

# Database Connections (Supabase PostgreSQL)
# DATABASE_URL used for application/runtime query connections (e.g. Supabase Transaction Connection pool)
DATABASE_URL=
# DIRECT_URL used for Prisma database migrations (direct connection to Supabase DB)
DIRECT_URL=

# Security and Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=*

# Logging
# Levels: error, warn, info, http, debug
LOG_LEVEL=info
